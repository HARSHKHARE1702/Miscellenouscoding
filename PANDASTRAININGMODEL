df = pd.read_csv("customers.csv")

#1.Inspect
print(df.shape)
print(df.info())

#2.Remove duplicates
df = df.drop_duplicates()

#3. Clean strings
df["City"]=df["City"].str.strip().str.lower()

#4. Convert numeric column
df["Income"]=pd.to_numeric(
    df["Income"],
    errors="coerce"
)

#5 Missing values
df["Income"]=df["Income"].fillna(
    df["Income"].median()
)

#6 Validate age
df.loc[
    (df["Age"]<18)|(df["Age"]>100)
    "Age"
]= np.nan 

#7. Fill age
df["Age"] = df["Age"].fillna(
    df["Age"].median()
)

#Reset index
df = df.reset_index(drop=True)
